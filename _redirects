# Boomer Automation — production canonical redirects
# Netlify automatically serves flat HTML files at clean URLs:
# /services -> /services.html, /about -> /about.html, and so on.
# Only redirect explicit legacy .html URLs to their canonical clean URLs.

/index.html / 301!
/index / 301!
/services.html /services 301!
/systems.html /systems 301!
/process.html /process 301!
/portfolio.html /portfolio 301!
/resources.html /resources 301!
/about.html /about 301!
/contact.html /contact 301!
/privacy.html /privacy 301!
